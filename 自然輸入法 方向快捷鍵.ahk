#Requires AutoHotkey v2.0
#SingleInstance Force

; 建立一個全域變數，用來標記目前是否正在選字
global isSelecting := false

; -------------------------------------------------------------------
; 1. 啟動開關：當你按下 Ctrl + Q 叫出候選字列表時，順便開啟對應模式
; -------------------------------------------------------------------
~^q:: {
    global isSelecting
    isSelecting := true
}
; -------------------------------------------------------------------
; 1. 備用啟動開關：適用於任意其他需要方向鍵映射的情況 按鍵為Ctrl＋Shift＋Q
; -------------------------------------------------------------------
~^+q:: {
    global isSelecting
    isSelecting := true
}


; -------------------------------------------------------------------
; 2. 只有在選字模式開啟時，這些快捷鍵才會生效，絕不影響平常打字
; -------------------------------------------------------------------
#HotIf isSelecting

; 用 Tab 和 CapsLock 來控制上下移動
Tab::Send("{Up}")
CapsLock::Send("{Down}")

; 用 [ 和 ] 來控制左右換頁
[::Send("{Left}")
]::Send("{Right}")

; 按下＋＝回到第一頁：關閉當前清單，並立刻重新觸發 Down 打開，達到瞬間重設回第一頁的效果
=:: {
    Send("{Esc}")       ; 關閉目前的候選字列表
    Sleep(50)           ; 微調延遲 50 毫秒，確保輸入法反應過來
    Send("{Down}")          ; 打開候選字列表（回到第一頁）
}


; -------------------------------------------------------------------
; 3. 關閉開關：當你按下 Esc（關閉列表）或 Enter / 數字鍵（選好字）時，自動關閉映射
; 另外還有各種常用按鍵也能關閉：修飾鍵 系統鍵 滑鼠 推薦左Ctrl
; -------------------------------------------------------------------

~Esc::
~Enter::
~Space::

~LWin::
~RWin::
~Ctrl::
~Alt::
~Shift::

~LButton::
~RButton::
~MButton::
~XButton1::
~XButton2::

~1::
~2::
~3::
~4::
~5::
~6::
~7::
~8::
~9::
~0:: {
    global isSelecting
    isSelecting := false
}

#HotIf ; 結束條件，以下恢復一般鍵盤行為


; -------------------------------------------------------------------
; 全域關閉此AHK腳本
; 按下 Shift＋Alt＋Q 快速關閉此腳本
; -------------------------------------------------------------------
+!q::ExitApp
